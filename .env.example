DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/appwatch
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3001
COOKIE_SECURE=false
CORS_ORIGIN=

# Optional email alerts. Use your SMTP provider's settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional per-check global cap. Per-account timeout is configured in Settings.
CHECK_CONCURRENCY=8

# Optional destinations on private networks. Leave blank to block private IP targets.
MONITOR_ALLOWED_CIDRS=
APP_BASE_URL=http://localhost:5173

# Automated PostgreSQL backups. pg_dump/pg_restore must be available on PATH,
# or set PG_DUMP_PATH / PG_RESTORE_PATH to their full executable paths.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
