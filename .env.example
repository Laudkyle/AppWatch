DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/appwatch
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3001
COOKIE_SECURE=false

# Optional email alerts. Use your SMTP provider's settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional per-check global cap. Per-account timeout is configured in Settings.
CHECK_CONCURRENCY=8
