{
  "name": "appwatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:worker:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/main.js",
    "worker:dev": "node --watch server/worker.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node server/main.js",
    "worker": "node server/worker.js",
    "db:backup": "node scripts/backup.js",
    "backup:worker": "node scripts/backup-worker.js",
    "db:restore": "node scripts/restore.js"
  },
  "dependencies": { "bcryptjs": "^2.4.3", "connect-pg-simple": "^10.0.0", "cors": "^2.8.5", "dotenv": "^16.4.7", "express": "^5.1.0", "express-session": "^1.18.1", "ipaddr.js": "^2.2.0", "lucide-react": "^0.468.0", "nodemailer": "^6.9.16", "pg": "^8.13.1", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": { "@vitejs/plugin-react": "^4.3.4", "autoprefixer": "^10.4.20", "concurrently": "^9.1.2", "postcss": "^8.4.49", "tailwindcss": "^3.4.16", "vite": "^6.0.5" }
}
